# Copy to .env at repo root; docker compose reads it automatically.
#
# These three are required — the gateway refuses to start without them.

NAVIDROME_URL=http://nav.lan:4533
NAVIDROME_USERNAME=alice
NAVIDROME_PASSWORD=wonderland


# Everything below is optional.

# Hostname the self-signed cert is issued for. Match this to whatever
# entry your client devices have in /etc/hosts (or mDNS).
# GATEWAY_HOSTNAME=gateway.local

# Comma-separated OAuth redirect URIs the web client is allowed to use.
# Default covers same-origin on gateway.local. Add a localhost entry
# during dev if you're running Vite separately.
# OAUTH_WEB_REDIRECT_URIS=https://gateway.local:8443/oauth/callback,http://localhost:5173/oauth/callback

# Host port to bind. The container always listens on 8443 internally.
# GATEWAY_PORT=8443

# Embedder backend: `stub` (no deps, deterministic hash vectors) or
# `clap` (real CLAP inference — requires the CLAP-variant image).
# EMBEDDER_BACKEND=stub

# CLAP checkpoint path on the *host*, bind-mounted read-only into the
# embedder container at /models/clap.pt. Consulted by both
# docker-compose.clap.yml (CPU) and docker-compose.clap-rocm.yml
# (GPU). The default points at the LAION music-audioset weights as
# dropped into the repo's `models/` dir during dev; override for a
# different checkpoint or a system-wide install location.
# CLAP_CHECKPOINT_PATH=./models/music_audioset_epoch_15_esc_90.14.pt

# ─── CLaMP 3 variant (docker-compose.clamp3.yml) ──────────────────────
# Crates config directory on the host — the parent for component data the
# containers bind-mount (e.g. a `crates` dir under your NAS's configs
# dataset). Required by .clamp3.yml. The embedder reads the saas
# checkpoint from this dir's `models/` subdirectory:
#   $CRATES_CONFIG_DIR/models/<saas-filename>.pth  ->  /models/<...> in-container
# CRATES_CONFIG_DIR=/mnt/pool/configs/crates
#
# The checkpoint filename IS the embedding model_version — keep the real
# upstream name (renaming silently split-brains the embedding store).
# CLAMP3_CHECKPOINT is the *in-container* path; it defaults to the
# canonical saas filename baked into the image. Override only if your
# file differs, and match it under $CRATES_CONFIG_DIR/models.
# CLAMP3_CHECKPOINT=/models/weights_clamp3_saas_h_size_768_t_model_FacebookAI_xlm-roberta-base_t_length_128_a_size_768_a_layers_12_a_length_128_s_size_768_s_layers_12_p_size_64_p_length_512.pth
#
# MERT-v1-95M is baked into the image's HF cache, so the hub id resolves
# offline. Point at a /models path instead if you bind-mount a local copy.
# MERT_FOLDER=m-a-p/MERT-v1-95M
#
# Embedding-space dim. CLaMP 3 is 768 (CLAP was 512). .clamp3.yml sets
# this to 768 on the gateway; the gateway defaults to 512 when unset.
# Changing it requires wiping the ANN sidecar (see .clamp3.yml header).
# RECOMMEND_EMBEDDING_DIM=768

# Host GIDs for the `render` and `video` groups — granted to the
# embedder container so it can open /dev/kfd and /dev/dri/render*.
# Only consulted by docker-compose.clap-rocm.yml. Defaults match
# Arch / Cachy / Fedora. On Debian/Ubuntu these are typically
# render=109, video=44; check with `getent group render video`.
# RENDER_GID=988
# VIDEO_GID=984

# Tracing filter.
# RUST_LOG=info,music_gateway=info,sqlx=warn

# Per-service memory caps. Docker enforces these as hard limits — the
# kernel OOM-kills the offending container instead of swallowing the
# whole host. Defaults are sized for a typical single-user deploy:
#   - gateway: 1g (mostly I/O; bump if you set a multi-GB audio cache)
#   - embedder stub: 512m
#   - embedder CLAP CPU (.clap.yml): 4g (overrides the base)
#   - embedder CLAP ROCm (.clap-rocm.yml): 6g (overrides the base)
#   - embedder CLaMP 3 CPU (.clamp3.yml): 6g (overrides the base)
# GATEWAY_MEM_LIMIT=1g
# EMBEDDER_MEM_LIMIT=512m

# Docker JSON log rotation. Without this, `docker logs` accumulates
# forever and one chatty error eats the host disk. Defaults give a
# 30 MB ceiling per service (10 MB × 3 rotated files).
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3

# --- Split-host deployment (embedder on a different machine) -----------
# Used by docker-compose.gateway-only.yml and docker-compose.embedder-only.yml.
# Ignore these if you're running the all-in-one stack (docker-compose.yml).
#
# Embedder URL the gateway dials. http:// is fine on a trusted LAN; use
# https:// only if you put a reverse proxy with TLS in front of the
# embedder. Required on the gateway host in split-host mode.
# EMBEDDER_URL=http://gpu-box.lan:9000
#
# Shared secret authenticating gateway → embedder. Set the same value
# on both hosts. Generate with: openssl rand -hex 32
# When unset, the embedder accepts unauthenticated requests — fine on
# a trusted LAN but not recommended.
# EMBEDDER_BEARER_TOKEN=
#
# Host port the embedder publishes. Only consulted by
# docker-compose.embedder-only.yml.
# EMBEDDER_PORT=9000
